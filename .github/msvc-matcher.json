{
  "problemMatcher": [
    {
      "owner": "calgram-msvc",
      "pattern": [
        {
          "regexp": "^\\s*(?:\\d+>)?([^\\s(][^(]*?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*(?:fatal\\s+)?(error)\\s+(\\w+\\d+)\\s*:\\s*(.*?)(?:\\s+\\[[^\\]]*\\])?\\s*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
